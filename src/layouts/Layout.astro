---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "DM相場",
  description = "デュエル・マスターズの販売・買取相場を素早く検索",
} = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <slot />
  </body>
</html>
